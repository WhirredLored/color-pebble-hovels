# =============================================================================
# Huestone Homes — Environment Variables
# =============================================================================
# Copy this file to .env (for local development) or set these variables
# in Cloudflare Workers Dashboard (Settings > Variables and Secrets).
# =============================================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Optional: Cloudflare Hyperdrive Connection (auto-injected if binding configured)
# HYPERDRIVE_URL=

# Cloudflare R2 Photographic Asset Hosting
# Set to your custom subdomain (e.g., https://photos.huestonehomes.com)
# or public R2 bucket URL (e.g., https://pub-<hash>.r2.dev).
# If left blank, images fall back to local /photos/ static assets.
VITE_PHOTO_CDN_URL=

# Cloudflare R2 Bucket Name (default: huestone-portfolio)
R2_PORTFOLIO_BUCKET=huestone-portfolio
