{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "huestone-homes",
  "compatibility_date": "2026-10-18",
  "main": "./workers/app.ts",
  "assets": {
    "directory": "build/client"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "huestonehomes.com",
      "custom_domain": true
    },
    {
      "pattern": "www.huestonehomes.com",
      "custom_domain": true
    }
  ]
}
