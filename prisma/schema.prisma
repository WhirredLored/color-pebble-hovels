// =============================================================================
// Huestone Homes LLC — Prisma Schema
// =============================================================================
// Production-grade relational schema for high-end home restoration,
// painting, and CNC carving operations.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  CLIENT
  ADMIN
  ESTIMATOR
}

enum ProjectStatus {
  LEAD
  ESTIMATING
  ACTIVE
  WARRANTY
  COMPLETED
}

enum ProjectType {
  PAINTING
  RESTORATION
  CNC_CARVING
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum ContractStatus {
  PENDING
  SIGNED
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LineItemCategory {
  MATERIALS
  LABOR
  CNC_MACHINE_TIME
  EQUIPMENT
  SUBCONTRACTOR
  PERMITS
  OVERHEAD
}

// =============================================================================
// Models
// =============================================================================

/// Core user identity, linked to Supabase for authentication.
model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique @map("supabase_id")
  email      String   @unique
  role       Role     @default(CLIENT)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  profile  Profile?
  projects Project[]

  @@map("users")
}

/// Extended profile information for a user.
model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique @map("user_id")
  firstName   String? @map("first_name")
  lastName    String? @map("last_name")
  companyName String? @map("company_name")
  phone       String?
  avatarUrl   String? @map("avatar_url")
  bio         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// A home restoration, painting, or CNC carving project.
model Project {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  name          String
  description   String?
  address       String
  city          String?
  state         String?
  zipCode       String?       @map("zip_code")
  projectStatus ProjectStatus @default(LEAD) @map("project_status")
  projectType   ProjectType   @map("project_type")
  startDate     DateTime?     @map("start_date")
  endDate       DateTime?     @map("end_date")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  estimates    Estimate[]
  invoices     Invoice[]
  changeOrders ChangeOrder[]
  warranty     Warranty?

  @@index([userId])
  @@index([projectStatus])
  @@index([projectType])
  @@map("projects")
}

/// A cost estimate for a project, containing line items.
model Estimate {
  id         String         @id @default(cuid())
  projectId  String         @map("project_id")
  status     EstimateStatus @default(DRAFT)
  title      String?
  notes      String?
  subtotal   Decimal        @default(0) @db.Decimal(12, 2)
  taxRate    Decimal        @default(0) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount  Decimal        @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total      Decimal        @default(0) @db.Decimal(12, 2)
  validUntil DateTime?      @map("valid_until")
  sentAt     DateTime?      @map("sent_at")
  approvedAt DateTime?      @map("approved_at")
  rejectedAt DateTime?      @map("rejected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lineItems    LineItem[]
  contract     Contract?
  invoices     Invoice[]
  changeOrders ChangeOrder[]

  @@index([projectId])
  @@index([status])
  @@map("estimates")
}

/// A single cost line item within an estimate.
model LineItem {
  id          String           @id @default(cuid())
  estimateId  String           @map("estimate_id")
  description String
  quantity    Decimal          @default(1) @db.Decimal(10, 2)
  unitCost    Decimal          @default(0) @map("unit_cost") @db.Decimal(12, 2)
  laborCost   Decimal          @default(0) @map("labor_cost") @db.Decimal(12, 2)
  totalCost   Decimal          @default(0) @map("total_cost") @db.Decimal(12, 2)
  category    LineItemCategory
  sortOrder   Int              @default(0) @map("sort_order")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@index([category])
  @@map("line_items")
}

/// An invoice linked to a project and optionally an estimate.
model Invoice {
  id                  String        @id @default(cuid())
  projectId           String        @map("project_id")
  estimateId          String?       @map("estimate_id")
  invoiceNumber       String        @unique @map("invoice_number")
  status              InvoiceStatus @default(UNPAID)
  amountDue           Decimal       @default(0) @map("amount_due") @db.Decimal(12, 2)
  amountPaid          Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  dueDate             DateTime?     @map("due_date")
  paidAt              DateTime?     @map("paid_at")
  stripePaymentIntent String?       @map("stripe_payment_intent")
  stripeInvoiceId     String?       @map("stripe_invoice_id")
  notes               String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  estimate Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([estimateId])
  @@index([status])
  @@index([stripePaymentIntent])
  @@map("invoices")
}

/// A contract associated with an approved estimate.
model Contract {
  id                 String         @id @default(cuid())
  estimateId         String         @unique @map("estimate_id")
  status             ContractStatus @default(PENDING)
  docusignEnvelopeId String?        @map("docusign_envelope_id")
  terms              String?
  signedAt           DateTime?      @map("signed_at")
  expiresAt          DateTime?      @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([docusignEnvelopeId])
  @@map("contracts")
}

/// A modification to an original estimate/project with approval tracking.
model ChangeOrder {
  id          String            @id @default(cuid())
  projectId   String            @map("project_id")
  estimateId  String?           @map("estimate_id")
  title       String
  description String?
  status      ChangeOrderStatus @default(PENDING)
  amountDelta Decimal           @default(0) @map("amount_delta") @db.Decimal(12, 2)
  requestedBy String?           @map("requested_by")
  approvedBy  String?           @map("approved_by")
  approvedAt  DateTime?         @map("approved_at")
  rejectedAt  DateTime?         @map("rejected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  estimate Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([estimateId])
  @@index([status])
  @@map("change_orders")
}

/// Warranty coverage for a completed project.
model Warranty {
  id            String    @id @default(cuid())
  projectId     String    @unique @map("project_id")
  coverageStart DateTime  @map("coverage_start")
  coverageEnd   DateTime  @map("coverage_end")
  terms         String?
  claimFiled    Boolean   @default(false) @map("claim_filed")
  claimDetails  String?   @map("claim_details")
  claimFiledAt  DateTime? @map("claim_filed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([coverageEnd])
  @@map("warranties")
}

/// An inquiry submitted through the public contact form.
model ContactInquiry {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  address String?
  message String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("contact_inquiries")
}
